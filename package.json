{
  "name": "docpulse",
  "version": "1.0.0",
  "description": "Documentation freshness checker — flag outdated docs based on code changes",
  "main": "src/docpulse.js",
  "bin": {
    "docpulse": "src/docpulse.js"
  },
  "scripts": {
    "start": "node src/docpulse.js",
    "test": "node --test src/*.test.js 2>/dev/null || echo 'No tests — add tests in src/*.test.js'",
    "lint": "eslint src/ --ext .js",
    "tracker": "node src/achievement-tracker.js",
    "roadmap": "node src/achievement-tracker.js"
  },
  "keywords": ["documentation", "freshness", "git", "stale", "outdated", "cli"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "glob": "^10.3.10",
    "micromatch": "^4.0.7"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
